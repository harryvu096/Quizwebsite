{
  "name": "boltys-puzzle-park",
  "version": "1.0.0",
  "displayName": "Bolty's Puzzle Park: 3 in 1",
  "description": "Screw, Sort & Arrow - 110 levels, 11 bosses, offline, 60MB",
  "author": "Bolty Games Studio",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "npx serve .",
    "cap:add": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open": "npx cap open android",
    "cap:build": "npx cap sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/core": "^6.0.0",
    "@capacitor/android": "^6.0.0",
    "@capacitor/app": "^6.0.0",
    "@capacitor/haptics": "^6.0.0",
    "@capacitor/status-bar": "^6.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.0.0"
  }
}
